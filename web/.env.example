# Web app (Vite). Copy to web/.env (or .env.local) — or set in your host's
# build settings. Vite inlines VITE_* vars at BUILD time, so set this before
# `npm run build -w web`.

# Base URL of the Fallow registry the web app talks to.
# Local dev:
VITE_REGISTRY_URL=http://localhost:4000
# Production example (must be HTTPS if the site is served over HTTPS):
# VITE_REGISTRY_URL=https://api.your-fallow-domain.com

# Soroban RPC endpoint the wallet uses to build + simulate the topup() contract call (public node).
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
