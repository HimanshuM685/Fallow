# All config has working testnet defaults baked into src/lib/config.ts, so you
# can run the app with no .env at all. Override any of these to point the
# frontend at a different deployment.

# NEXT_PUBLIC_CONTRACT_ID=
# NEXT_PUBLIC_NATIVE_SAC_ID=
# NEXT_PUBLIC_ADMIN_ADDRESS=
# NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
